# All values below are the defaults; copy to .env only to override.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

REDIS_URL=redis://localhost:6379

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers
WORKFLOW_TIMEOUT_MS=5000

SUPPLIER_A_URL=http://localhost:3000/supplierA
SUPPLIER_B_URL=http://localhost:3000/supplierB
SUPPLIER_TIMEOUT_MS=2000

CACHE_FRESH_TTL_SECONDS=600
CACHE_HARD_TTL_SECONDS=86400
